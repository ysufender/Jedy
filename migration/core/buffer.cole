import std::collections::hashmap;
import std::memory::allocator;
import std::c::memory;
import std::hash;
import std;

let Allocator = std::memory::allocator::Allocator;
let BufferMap = std::collections::hashmap::HashMap([]u8, Buffer, std::hash::FNV1a64, 75);

let DefaultOverhead = 255;

let max = fn (this: u32, that: u32) -> u32 {
    return if (this > that) this else that;
};

pub let Buffer = struct {
    used: mut u32,
    cap: mut u32,
    buffer: mut []mut u8,
    readonly: bool,

    pub let destroy = fn (self: *Buffer, gpa: Allocator) -> void {
        Allocator::dealloc(u8)(gpa, self.buffer);
    };

    pub let create = fn (gpa: Allocator, size: u32, readonly: bool) -> std::Option(mut Buffer) {
        let cap = size + DefaultOverhead;
        let mem = Allocator::alloc(u8)(gpa, cap).Ok;

        return (@Some, construct(cap, mem, readonly));
    };
    
    pub let assign = fn (self: *mut Buffer, gpa: Allocator, buf: []u8) -> std::Option([]u8) {
        if !reserve(self, gpa, buf.len) {
            return (@Some, "Out of memory.");
        }

        if buf.len != 0 {
            std::c::memory::copy(unsafeCast(self.buffer.ptr), unsafeCast(buf.ptr), buf.len);
        }
        
        self.used = buf.len;
        return (@None, ());
    };
    
    pub let view = fn (self: *Buffer) -> []u8 {
        return self.buffer[0..self.used];
    };
    
    let reserve = fn (self: *mut Buffer, gpa: Allocator, needed: u32) -> bool {
        if needed <= self.cap {
            return true;
        }

        let newCap = max(needed, self.cap * 2);
        let raw = Allocator::realloc(u8)(gpa, cast(self.buffer), newCap);
        switch raw {
            @Ok -> { }
            else -> return false;
        }

        self.buffer = cast(raw.Ok);
        self.cap = newCap;
        return true;
    };
    
    let construct = fn (capacity: u32, buffer: mut []mut u8, readonly: bool) -> Buffer {
        return (0, capacity, buffer, readonly);
    };
};

pub let Manager = struct {
    gpa: Allocator,
    map: BufferMap,

    pub let init = fn (gpa: Allocator) -> std::Option(mut Manager) {
        switch BufferMap::init(gpa) {
            @Some -> |map| {
                return (@Some, gpa, map);
            }
            @None -> return (@None, ());
        }

        return (@None, ());
    };

    pub let buffer = fn (self: *mut Manager, name: []u8, size: u32, readonly: bool) -> std::Option([]u8) {
        switch Buffer::create(self.gpa, size, readonly) {
            @Some -> |buf| {
                if BufferMap::contains(self.map.&, name) {
                    return (@Some, "A buffer with the same name already exists.");
                }

                switch BufferMap::put(self.map.&, self.gpa, name, buf) {
                    @Ok -> { }
                    @Err -> return (@Some, "Allocation error while adding buffer.");
                }
            }
            @None -> return (@Some, "Failed to create buffer");
        }

        return (@None, ());
    };

    pub let get = fn (self: *Manager, name: []u8) -> std::Option(*mut Buffer) {
        return switch BufferMap::get(self.map.&, name) {
            @Some -> |b| (@Some, b),
            else -> (@None, ())
        };
    };

    pub let remove = fn (self: *mut Manager, name: []u8) -> std::Option([]u8) {
        return
            if (BufferMap::remove(self.map.&, name)) (@None, ())
            else (@Some, "No such buffer.");
    };

    pub let flush = fn (self: *Manager, name: []u8) -> std::Option([]u8) {
        return switch get(self, name) {
            @Some -> (@Some, "IO is not yet implemented."),
            @None -> (@Some, "No buffer found with given name."),
        };
    };
};
