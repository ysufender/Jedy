import std;
import std::string;
import std::io::console as Console;

pub let TotalArgs = 2;

pub let Value = union(enum) {
    Undefined: void,
    String: mut []u8,
    Bool: mut bool,

    pub let typestr = fn (val: Value) -> []u8 {
        return switch val {
            @String -> "string",
            @Bool -> "bool",
            @Undefined -> "undefined",
        };
    };

    pub let str = fn (val: Value) -> []u8 {
        return switch val {
            @String -> |str| str,
            @Bool -> |b| if (b) "true" else "false",
            @Undefined -> "undefined",
        };
    };
};

pub let Args = struct {
    args: mut [TotalArgs] mut struct {
        name: []u8,
        value: Value,
        description: []u8,
    },
    size: mut u32,
    _args: [][]u8,

    pub let create = fn (args: [][]u8) -> mut Args {
        return (undefined, 0, args);
    };

    pub let option = fn (self: *mut Args, name: []u8, def: bool, desc: []u8) -> bool {
        if self.size >= TotalArgs {
            return true;
        }

        self.args[self.size] = (name, (@Bool, def), desc);
        self.size = self.size + 1;
        return false;
    };

    pub let param = fn (self: *mut Args, name: []u8, def: []u8, desc: []u8) -> bool {
        if self.size >= TotalArgs {
            return true;
        }

        self.args[self.size] = (name, (@String, def), desc);
        self.size = self.size + 1;
        return false;
    };

    pub let mutableGet = fn (self: *mut Args, name: []u8) -> std::Option(*mut Value) {
        for 0..self.size, |i| {
            let arg = self.args[i].&;
            if std::string::equals(arg.name, name) {
                return (@Some, arg.value.&);
            }
        }

        return (@None, ());
    };

    pub let get = fn (self: *Args, name: []u8) -> std::Option(*Value) {
        for 0..self.size, |i| {
            let arg = self.args[i].&;
            if std::string::equals(arg.name, name) {
                return (@Some, arg.value.&);
            }
        }

        return (@None, ());
    };

    pub let parse = fn (self: *mut Args) -> bool {
        let i: mut u32 = 0;
        while i < self._args.len {
            let arg = self._args[i];
            i = i + 1;

            if arg[0] == '-' {
                let maybeValueRef = mutableGet(self, arg[1..arg.len]);

                switch maybeValueRef {
                    @Some -> |ref| switch ref.tag {
                        @String -> {
                            if i >= self._args.len {
                                Console::write("Expected a string value after: ");
                                Console::log(arg);
                                return true;
                            }

                            ref.String = self._args[i];
                            i = i + 1;
                        }
                        @Bool -> {
                            ref.Bool = true;
                        }
                        else -> { }
                    }
                    @None -> {
                        Console::write("Unknown command line argument: ");
                        Console::log(arg);
                        return true;
                    }
                }
            }
            else {
                Console::write("Unknown command line argument: ");
                Console::log(arg);
                return true;
            }
        }

        return false;
    };

    pub let help = fn (self: *Args) -> void {
        Console::log("Usage:");

        for 0..self.size, |i| {
            let entry = self.args[i];
            Console::write("    ");
            Console::write(entry.name);
            Console::write(" <default = ");
            Console::write(Value::str(entry.value));
            Console::write("> : ");
            Console::write(entry.description);
            Console::write("\n");
        }
    };
};
