import std;
import std::string;
import std::io::console as Console;

pub let TotalArgs = 2;

pub let Value = union(enum) {
    Undefined: void,
    String: mut []u8,
    Bool: mut bool,

    pub let typestr = fn (val: Value) -> []u8 {
        return switch val {
            @String -> "string",
            @Bool -> "bool",
            @Undefined -> "undefined",
        };
    };

    pub let str = fn (val: Value) -> []u8 {
        return switch val {
            @String -> |str| str,
            @Bool -> |b| if (b) "true" else "false",
            @Undefined -> "undefined",
        };
    };
};

pub let Args = struct {
    args: [TotalArgs] struct {
        _0: []u8,
        _1: Value,
        _2: []u8,
    },
    size: u32,
    _args: [][]u8,

    pub let create = fn (args: [][]u8) -> Args {
        return (undefined, 0, args);
    };

    pub let option = fn (self: *mut Args, name: []u8, def: bool, desc: []u8) -> bool {
        if self.size >= TotalArgs {
            return false;
        }

        self.args[self.size] = (name, (@Bool, def), desc);
        self.size = self.size + 1;
        return true;
    };

    pub let param = fn (self: *mut Args, name: []u8, def: []u8, desc: []u8) -> bool {
        if self.size >= TotalArgs {
            return false;
        }

        self.args[self.size] = (name, (@String, def), desc);
        self.size = self.size + 1;
        return true;
    };

    pub let mutableGet = fn (self: *mut Args, name: []u8) -> std::Option(*mut Value) {
        for self.args, |arg| {
            if std::string::equals(arg._0, name) {
                return (@Some, arg);
            }
        }

        return (@None, ());
    };

    pub let get = fn (self: *mut Args, name: []u8) -> std::Option(*mut Value) {
        for self.args, |arg| {
            if std::string::equals(arg._0, name) {
                return (@Some, arg);
            }
        }

        return (@None, ());
    };

    pub let parse = fn (self: *mut Args) -> std::Option([]u8) {
        let i: mut u32 = 0;
        while i < self._args.len {
            let arg = self._args[i];
            i = i + 1;

            if arg[0] == '-' {
                let maybeValueRef = get(self, arg[1..arg.len - 1]);

                switch maybeValueRef {
                    @Some -> |ref| switch ref.tag {
                        @String -> {
                            if i == self._args.len - 1 {
                                Console::write("Expected a string value after: ");
                                Console::log(arg);
                                return (@Some, "<missing argument>");
                            }

                            maybeValueRef.String = self._args[i];
                        }
                        @Bool -> {
                            maybeValueRef.Bool = true;
                        }
                        else -> { }
                    }
                    @None -> {
                        Console::write("Unknown command line argument: ");
                        Console::log(arg);
                        return (@Some, "<unknown>");
                    }
                }
            }
            else {
                Console::write("Unknown command line argument: ");
                Console::log(arg);
                return (@Some, "<unknown>");
            }
        }
    };
};
