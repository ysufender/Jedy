import std::memory::allocator::arena;
import std::io::console as Console;
import std::io::stream as Stream;
import std::memory::allocator;
import std::io::file as File;
import std::c as C;
import std::debug;

import core::cli;
import core::buffer;

let print = std::debug::print;

let Args = core::cli::Args;
let Arena = std::memory::allocator::arena::Arena;
let Allocator = std::memory::allocator::Allocator;

let main = fn (_args: [][]u8) -> i32 {
    let args = Args::create(_args);

    if
        args.&.option("h", false, "Display this help message")
        or args.&.option("gui", false, "Run in GUI mode instead of TUI.")
        or args.&.param("file", "default.txt", "File to open.")
        or args.&.parse() {
        Console::error("Failed to set params and parse CLI.");
        return 1;
    }

    let arena: mut Arena = undefined;
    switch Arena::init(C::Allocator, Arena::StandardSize) {
        @Some -> |s| arena = s;
        else -> return 1;
    }
    let gpa = arena.&.allocator();
    
    switch args.&.get("h") {
        @Some -> |value| if value.Bool {
            args.&.help();
            return 0;
        }
        @None -> { }
    }
    
    let res = switch args.&.get("gui") {
        @Some -> |value|
            if (value.Bool) gui(args.&)
            else tui(args.&, gpa),
        @None -> tui(args.&, gpa),
    };

    arena.&.deinit();
    return 0;
};

let gui = fn (args: *Args) -> i32 {
    Console::error("GUI Mode is not yet implemented.");
    return 1;
};

let tui = fn (args: *Args, gpa: Allocator) -> i32 {
    let Buffer = core::buffer::Buffer;
    let Manager = core::buffer::Manager;

    let manager: mut Manager = undefined;
    switch Manager::init(gpa) {
        @Some -> |m| manager = m;
        @None -> {
            Console::error("Failed to create buffer manager.");
            return 1;
        }
    }

    let file = switch args.get("file") {
        @Some -> |f| f.String,
        else -> "",
    };

    let text: mut []u8 = "";
    {
        switch File::Input::open(file, gpa, false) {
            @Ok -> |f| {
                let stream = f.stream();
                _ = stream.seek(0, Stream::Base::End);
                let size = stream.tell();
                _ = stream.seek(0, Stream::Base::Start);

                switch gpa.alloc(u8)(size) {
                    @Ok -> |mem| {
                        for 0..size, |i| {
                            let res = stream.read();

                            switch res {
                                @Ok -> |ch| mem[i] = ch;
                                @Err -> |err| {
                                    return 1;
                                }
                                @EOS -> break;
                            }
                        }

                        text = mem;
                    }
                    @Err -> |err| {
                        return 1;
                    }
                }
            }
            else -> { }
        }
    }

    switch manager.&.buffer(file, text.len, false) {
        @Some -> |s| {
            print("Error: Failed to create buffer, %", ([]u8))(@(s));
            return 1;
        }
        else -> { }
    }

    switch manager.&.get(file).Some.assign(manager.gpa, text) {
        @Some -> |s| {
            print("Error: Failed to assign to buffer, %", ([]u8))(@(s));
            return 1;
        }
        else -> { }
    }

    switch manager.&.buffer("<command_buffer>", 256, false) {
        @Some -> |s| {
            print("Error: Failed to create command buffer, %", ([]u8))(@(s));
            return 1;
        }
        else -> { }
    }

    switch manager.&.buffer("<copy>", 256, false) {
        @Some -> |s| {
            print("Error: Failed to create copy buffer, %", ([]u8))(@(s));
            return 1;
        }
        else -> { }
    }

    switch manager.&.buffer("<explorer>", 256, true) {
        @Some -> |s| {
            print("Error: Failed to create explorer buffer, %", ([]u8))(@(s));
            return 1;
        }
        else -> { }
    }

    print("%", (u32))(("\n\0\x03".len));
    
    return 0;
};
