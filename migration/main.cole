import std::io::console as Console;
import std::c as C;

import core::cli;
import core::buffer;

let Args = core::cli::Args;

let main = fn (_args: [][]u8) -> i32 {
    let args = Args::create(_args);

    if
        Args::option(args.&, "h", false, "Display this help message")
        or Args::option(args.&, "gui", false, "Run in GUI mode instead of TUI.")
        or Args::parse(args.&) {
        Console::error("Failed to set params and parse CLI.");
        return 1;
    }
    
    switch Args::get(args.&, "h") {
        @Some -> |value| if value.Bool {
            Args::help(args.&);
            return 0;
        }
        @None -> { }
    }
    
    return switch Args::get(args.&, "gui") {
        @Some -> |value|
            if (value.Bool) gui(args.&)
            else tui(args.&),
        @None -> tui(args.&),
    };
};

let gui = fn (args: *Args) -> i32 {
    Console::error("GUI Mode is not yet implemented.");
    return 1;
};

let tui = fn (args: *Args) -> i32 {
    let Buffer = core::buffer::Buffer;
    let Manager = core::buffer::Manager;
    let gpa = C::Allocator;

    let manager: mut Manager = undefined;
    switch Manager::init(gpa) {
        @Some -> |m| manager = m;
        @None -> {
            Console::error("Failed to create buffer manager.");
            return 1;
        }
    }

    let size = 0;
    {
    }

    let text = "";
    
    return 0;
};
